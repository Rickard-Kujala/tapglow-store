{{ 'section-hero.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #Hero-{{ section.id }} .hero__overlay {
    opacity: {{ section.settings.image_overlay_opacity | divided_by: 100.0 }};
  }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign hero_product_image = section.settings.product.featured_image
  if section.settings.product != blank and section.settings.product_image_index > 1
    assign fallback_index = section.settings.product_image_index | minus: 1
    assign indexed_image = section.settings.product.images[fallback_index]
    if indexed_image != blank
      assign hero_product_image = indexed_image
    endif
  endif
-%}

<div
  id="Hero-{{ section.id }}"
  class="hero hero--{{ section.settings.image_height }} color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding"
>
  {%- if section.settings.video != blank -%}
    <div class="hero__media">
      <deferred-media class="hero__media-video" data-media-id="{{ section.settings.video.id }}">
        <button
          class="deferred-media__poster"
          type="button"
          aria-label="{{ 'sections.video.load_video' | t: description: section.settings.heading | escape }}"
        >
          {%- if section.settings.image != blank -%}
            {{
              section.settings.image
              | image_url: width: 3200
              | image_tag: sizes: '100vw', widths: '750, 1100, 1500, 1780, 2000, 3000, 3200', loading: 'eager'
            }}
          {%- else -%}
            {{
              section.settings.video.preview_image
              | image_url: width: 3200
              | image_tag: sizes: '100vw', widths: '750, 1100, 1500, 1780, 2000, 3000, 3200', loading: 'eager'
            }}
          {%- endif -%}
          <span class="deferred-media__poster-button motion-reduce">
            <span class="svg-wrapper">{{- 'icon-play.svg' | inline_asset_content -}}</span>
          </span>
        </button>
        <template>
          {{
            section.settings.video
            | video_tag: image_size: '1100x', autoplay: true, loop: true, controls: false, muted: true
          }}
        </template>
      </deferred-media>
    </div>
  {%- elsif section.settings.image != blank -%}
    <div class="hero__media">
      {%- if section.settings.mobile_image != blank -%}
        {{
          section.settings.mobile_image
          | image_url: width: 1500
          | image_tag:
            class: 'hero__media-image--mobile-only',
            sizes: '100vw',
            widths: '375, 550, 750, 1100, 1500',
            loading: 'eager'
        }}
        {{
          section.settings.image
          | image_url: width: 3200
          | image_tag:
            class: 'hero__media-image--desktop-only',
            sizes: '100vw',
            widths: '750, 1100, 1500, 1780, 2000, 3000, 3200',
            loading: 'eager'
        }}
      {%- else -%}
        {{
          section.settings.image
          | image_url: width: 3200
          | image_tag: sizes: '100vw', widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3200', loading: 'eager'
        }}
      {%- endif -%}
    </div>
  {%- elsif hero_product_image != blank -%}
    <div class="hero__media">
      {{
        hero_product_image
        | image_url: width: 3200
        | image_tag:
          sizes: '100vw',
          widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3200',
          loading: 'eager',
          alt: hero_product_image.alt
      }}
    </div>
  {%- else -%}
    <div class="hero__placeholder" role="img" aria-label="TapGlow"></div>
  {%- endif -%}

  <div class="hero__overlay" aria-hidden="true"></div>

  <div class="hero__content-wrapper hero__content-wrapper--position-{{ section.settings.desktop_content_position }} page-width">
    <div
      class="hero__content hero__content--align-{{ section.settings.desktop_content_alignment }} hero__content--mobile-align-{{ section.settings.mobile_content_alignment }}"
    >
      <div class="hero__content-top">
        {%- if section.settings.eyebrow != blank -%}
          <p class="hero__eyebrow caption-with-letter-spacing">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h1 class="hero__heading inline-richtext {{ section.settings.heading_size }}">
            {{ section.settings.heading }}
          </h1>
        {%- endif -%}
      </div>
      <div class="hero__content-bottom">
        {%- if section.settings.text != blank -%}
          <div class="hero__text rte">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- if section.settings.primary_button_label != blank or section.settings.secondary_button_label != blank -%}
          <div class="hero__ctas hero__ctas--align-{{ section.settings.desktop_content_alignment }}">
            {%- if section.settings.primary_button_label != blank -%}
              <a
                {% if section.settings.primary_button_link == blank %}
                  role="link" aria-disabled="true"
                {% else %}
                  href="{{ section.settings.primary_button_link }}"
                {% endif %}
                class="button button--primary"
              >
                {{- section.settings.primary_button_label | escape -}}
              </a>
            {%- endif -%}
            {%- if section.settings.secondary_button_label != blank -%}
              <a
                {% if section.settings.secondary_button_link == blank %}
                  role="link" aria-disabled="true"
                {% else %}
                  href="{{ section.settings.secondary_button_link }}"
                {% endif %}
                class="link underlined-link button--secondary-link"
              >
                {{- section.settings.secondary_button_label | escape -}}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "class": "section section-hero",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "info": "Used as a fallback image when no image or video is selected above."
    },
    {
      "type": "range",
      "id": "product_image_index",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 1,
      "label": "Fallback image position",
      "info": "Which product image to use as the fallback (1 = featured image)."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image",
      "info": "Optional. Falls back to the image above."
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video",
      "info": "Optional. Shown as a poster image with a play button. Takes priority over the image."
    },
    {
      "type": "range",
      "id": "image_overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Overlay strength",
      "default": 30
    },
    {
      "type": "select",
      "id": "image_height",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "full-screen", "label": "Full screen" }
      ],
      "default": "large",
      "label": "Section height"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "default": "TAPGLOW",
      "label": "Eyebrow"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Satisfying clicks. Instant glow.",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h1", "label": "Large" },
        { "value": "h0", "label": "Extra large" },
        { "value": "hxl", "label": "Extra extra large" },
        { "value": "hxxl", "label": "Maximum" }
      ],
      "default": "hxl",
      "label": "Heading size"
    },
    {
      "type": "richtext",
      "id": "text",
      "default": "<p>A pocket-sized RGB clicker with crisp tactile feedback.</p>",
      "label": "Supporting text"
    },
    {
      "type": "header",
      "content": "Primary button"
    },
    {
      "type": "text",
      "id": "primary_button_label",
      "default": "Buy Now",
      "label": "Label"
    },
    {
      "type": "url",
      "id": "primary_button_link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Secondary button"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "default": "See It in Action",
      "label": "Label"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "desktop_content_position",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "middle", "label": "Middle" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "middle",
      "label": "Desktop content position"
    },
    {
      "type": "select",
      "id": "desktop_content_alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left",
      "label": "Desktop content alignment"
    },
    {
      "type": "select",
      "id": "mobile_content_alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left",
      "label": "Mobile content alignment"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-4"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "category": "Custom"
    }
  ]
}
{% endschema %}
