{{ 'section-comparison.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <div class="comparison__header">
        {%- if section.settings.eyebrow != blank -%}
          <p class="comparison__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="comparison__heading inline-richtext {{ section.settings.heading_size }}">
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="comparison__table">
      <div class="comparison__row comparison__row--header">
        <span></span>
        <span class="comparison__col-value">{{ section.settings.tapglow_label | escape }}</span>
        <span class="comparison__col-value">{{ section.settings.ordinary_label | escape }}</span>
      </div>
      {%- for block in section.blocks -%}
        <div class="comparison__row" {{ block.shopify_attributes }}>
          <span class="comparison__col-label">{{ block.settings.label | escape }}</span>
          <span class="comparison__col-value comparison__col-value--tapglow">
            {%- if block.settings.tapglow_included -%}
              <span class="svg-wrapper">{{- 'icon-checkmark.svg' | inline_asset_content -}}</span>
            {%- else -%}
              <span class="svg-wrapper">{{- 'icon-close-small.svg' | inline_asset_content -}}</span>
            {%- endif -%}
          </span>
          <span class="comparison__col-value comparison__col-value--ordinary">
            {%- if block.settings.ordinary_included -%}
              <span class="svg-wrapper">{{- 'icon-checkmark.svg' | inline_asset_content -}}</span>
            {%- else -%}
              <span class="svg-wrapper">{{- 'icon-close-small.svg' | inline_asset_content -}}</span>
            {%- endif -%}
          </span>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Comparison",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "default": "Why TapGlow",
      "label": "Eyebrow"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Not just another fidget toy.",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "t:sections.all.heading_size.options__1.label" },
        { "value": "h1", "label": "t:sections.all.heading_size.options__2.label" },
        { "value": "h0", "label": "t:sections.all.heading_size.options__3.label" }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "text",
      "id": "tapglow_label",
      "default": "TapGlow",
      "label": "Column 1 label"
    },
    {
      "type": "text",
      "id": "ordinary_label",
      "default": "Ordinary fidget toys",
      "label": "Column 2 label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-2"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 52
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Comparison row",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "default": "Premium presentation",
          "label": "Feature"
        },
        {
          "type": "checkbox",
          "id": "tapglow_included",
          "default": true,
          "label": "TapGlow: included"
        },
        {
          "type": "checkbox",
          "id": "ordinary_included",
          "default": false,
          "label": "Ordinary fidget toys: included"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Comparison",
      "category": "Custom",
      "blocks": [
        {
          "type": "row",
          "settings": {
            "label": "Premium presentation",
            "tapglow_included": true,
            "ordinary_included": false
          }
        },
        {
          "type": "row",
          "settings": {
            "label": "Discreet everyday carry",
            "tapglow_included": true,
            "ordinary_included": false
          }
        },
        {
          "type": "row",
          "settings": {
            "label": "Controlled tactile feedback",
            "tapglow_included": true,
            "ordinary_included": false
          }
        },
        {
          "type": "row",
          "settings": {
            "label": "Desk-friendly design",
            "tapglow_included": true,
            "ordinary_included": false
          }
        }
      ]
    }
  ]
}
{% endschema %}
