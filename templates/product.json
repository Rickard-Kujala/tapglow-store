{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "vendor": {
          "type": "text",
          "settings": {
            "text": "{{ product.vendor }}",
            "text_style": "uppercase"
          }
        },
        "title": {
          "type": "title",
          "settings": {}
        },
        "price": {
          "type": "price",
          "settings": {}
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "circle"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector",
          "settings": {}
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": true
          }
        },
        "benefits": {
          "type": "icon-with-text",
          "settings": {
            "layout": "horizontal",
            "icon_1": "lightning_bolt",
            "heading_1": "Precision magnetic click",
            "icon_2": "box",
            "heading_2": "Compact, everyday carry",
            "icon_3": "stopwatch",
            "heading_3": "Designed for focus"
          }
        },
        "description": {
          "type": "description",
          "settings": {}
        },
        "tab_shipping": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Shipping",
            "icon": "truck",
            "content": "<p>Shipping details will be published here once TapGlow is available to order.</p>"
          }
        },
        "tab_returns": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Returns",
            "icon": "return",
            "content": "<p>Our return policy will be confirmed before launch and shown here.</p>"
          }
        },
        "tab_care": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Care",
            "icon": "check_mark",
            "content": "<p>Care instructions will be added once final materials are confirmed.</p>"
          }
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "Share"
          }
        }
      },
      "block_order": [
        "vendor",
        "title",
        "price",
        "variant_picker",
        "quantity_selector",
        "buy_buttons",
        "benefits",
        "description",
        "tab_shipping",
        "tab_returns",
        "tab_care",
        "share"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_size": "large",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "gallery_layout": "thumbnail",
        "mobile_thumbnails": "show",
        "media_position": "left",
        "image_zoom": "lightbox",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 48,
        "padding_bottom": 24
      }
    },
    "faq": {
      "type": "collapsible-content",
      "blocks": {
        "q1": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What is TapGlow?",
            "icon": "none",
            "row_content": "<p>TapGlow is a premium magnetic clicker built for restless hands, quiet focus, and everyday carry. It's a tactile tool, not a toy.</p>",
            "page": ""
          }
        },
        "q2": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Is it noisy?",
            "icon": "none",
            "row_content": "<p>TapGlow is designed to be discreet. Final acoustic details will be confirmed closer to launch.</p>",
            "page": ""
          }
        },
        "q3": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Can I carry it in my pocket?",
            "icon": "none",
            "row_content": "<p>Yes. TapGlow is designed as an everyday carry object, sized to travel with you.</p>",
            "page": ""
          }
        },
        "q4": {
          "type": "collapsible_row",
          "settings": {
            "heading": "When will it ship?",
            "icon": "none",
            "row_content": "<p>TapGlow hasn't launched yet. Shipping timelines will be shared here as soon as they're confirmed.</p>",
            "page": ""
          }
        },
        "q5": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What is the return policy?",
            "icon": "none",
            "row_content": "<p>Our return policy will be published before TapGlow becomes available for purchase.</p>",
            "page": ""
          }
        }
      },
      "block_order": ["q1", "q2", "q3", "q4", "q5"],
      "settings": {
        "caption": "FAQ",
        "heading": "Frequently asked questions",
        "heading_size": "h1",
        "heading_alignment": "center",
        "layout": "none",
        "container_color_scheme": "scheme-2",
        "color_scheme": "scheme-1",
        "open_first_collapsible_row": true,
        "image_ratio": "adapt",
        "desktop_layout": "image_second",
        "padding_top": 48,
        "padding_bottom": 52
      }
    },
    "final_cta": {
      "type": "rich-text",
      "blocks": {
        "heading": {
          "type": "heading",
          "settings": {
            "heading": "Focus, one click at a time.",
            "heading_size": "h0"
          }
        },
        "button": {
          "type": "button",
          "settings": {
            "button_label": "Back to top",
            "button_link": "#MainContent",
            "button_style_secondary": false,
            "button_label_2": "",
            "button_link_2": "",
            "button_style_secondary_2": false
          }
        }
      },
      "block_order": ["heading", "button"],
      "settings": {
        "desktop_content_position": "center",
        "content_alignment": "center",
        "color_scheme": "scheme-4",
        "full_width": true,
        "padding_top": 64,
        "padding_bottom": 72
      }
    }
  },
  "order": ["main", "faq", "final_cta"]
}
